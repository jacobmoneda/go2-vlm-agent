from backend.objectDetection.yolo_engine import get_detections
from backend.robot_control import execute_action

DEAD_ZONE = 60


def decide_action(task, detections=None, frame_width=640):
    """
    Takes a processed user task and current YOLO detections
    and decides what robot command should be executed.

    Example task:
    {
        "action": "follow",
        "target": "person"
    }
    """

    action = task.get("action")
    target_class = task.get("target")

    # -------------------------
    # FOLLOW / TRACK BEHAVIOUR
    # -------------------------
    if action in ["follow", "track", "watch"]:

        if detections is None:
            return "stop"

        targets = [
            d for d in detections
            if d["label"] == target_class
            and d["confidence"] > 0.5
        ]

        if not targets:
            print("[Decision] Target not visible.")
            return "stop"

        # Largest bounding box = likely closest target
        target = max(
            targets,
            key=lambda d: d["box_height"]
        )

        center_x = frame_width // 2
        offset_x = target["box_center_x"] - center_x

        print(
            f"[Decision] Target={target_class} "
            f"offset={int(offset_x)}"
        )

        if offset_x > DEAD_ZONE:
            return "turn_right"

        elif offset_x < -DEAD_ZONE:
            return "turn_left"

        else:
            return "stop"


    # -------------------------
    # SIMPLE MOVEMENT COMMANDS
    # -------------------------
    elif action == "move":
        return "move_forward"


    elif action == "go to":
        # This will eventually need perception/navigation logic
        print("[Decision] 'go to' behaviour not implemented yet.")
        return "stop"


    # -------------------------
    # STOP
    # -------------------------
    elif action == "stop":
        return "stop"


    # -------------------------
    # POSTURE
    # -------------------------
    elif action == "sit":
        return "sit"

    elif action == "stand":
        return "stand_up"


    # -------------------------
    # EMOTES
    # -------------------------
    elif action == "wave":
        return "emote_wave"

    elif action == "emote":
        return "emote_wave"


    # -------------------------
    # FIND / SEARCH
    # -------------------------
    elif action in ["find", "search"]:
        print("[Decision] Search behaviour not implemented yet.")
        return "stop"


    # -------------------------
    # SAFE DEFAULT
    # -------------------------
    else:
        print(
            f"[Decision] Unknown action: {action}"
        )
        return "stop"